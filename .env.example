# Copy to .env.local and fill in. Never commit real keys.
# Local values come from `pnpm db:start`; hosted values from the Supabase and Vercel panels.

# Public site origin, used for absolute links and redirects.
NEXT_PUBLIC_SITE_URL=

# Supabase project REST endpoint.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Safe to expose to the browser; RLS is the real gate.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret (service role) key. Server only. Never referenced from client code.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by migration and pgTAP tooling.
SUPABASE_DB_URL=

# Sentry DSN. Leave empty to disable error reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source map upload. Only needed in CI and production builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Anthropic Claude API key. Server only. Leave empty in environments that
# never call the AI package (apps/web/src/features/ai) — app boot doesn't
# require it, only an actual AI call does.
ANTHROPIC_API_KEY=

# Model ids for the two quality tiers the AI package selects between
# (docs/02-mimari.md § 5.5). Defaults match the current Claude lineup.
AI_MODEL_QUALITY=claude-opus-5
AI_MODEL_FAST=claude-haiku-4-5

# Upstash Redis REST credentials, used for AI call rate limiting. Leave
# empty in local dev/tests: the AI package falls back to an in-process
# limiter (single-instance only, not for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
