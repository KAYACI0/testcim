# Copy to .env.local and fill in. Never commit real keys.
# Local values come from `pnpm db:start`; hosted values from the Supabase and Vercel panels.

# Public site origin, used for absolute links and redirects.
NEXT_PUBLIC_SITE_URL=

# Supabase project REST endpoint.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Safe to expose to the browser; RLS is the real gate.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret (service role) key. Server only. Never referenced from client code.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by migration and pgTAP tooling.
SUPABASE_DB_URL=

# Sentry DSN. Leave empty to disable error reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source map upload. Only needed in CI and production builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Anthropic Claude API key. Server only. Leave empty in environments that
# never call the AI package (apps/web/src/features/ai) — app boot doesn't
# require it, only an actual AI call does.
ANTHROPIC_API_KEY=

# Feature flags (JSON, optional). A flag that is absent or invalid stays off.
# Example: {"live-exam":{"enabled":true,"percent":10,"workspaces":["<workspace-id>"]}}
FEATURE_FLAGS=

# Model ids for the two quality tiers the AI package selects between
# (docs/02-mimari.md § 5.5). Defaults match the current Claude lineup.
AI_MODEL_QUALITY=claude-opus-5
AI_MODEL_FAST=claude-haiku-4-5

# Transactional email (Resend). Leave empty to skip sending; flows keep their in-app
# fallback. EMAIL_FROM must use a domain verified in Resend, for example
# "Testcim <bildirim@example.com>". CONTACT_NOTIFY_TO receives contact form notices.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_NOTIFY_TO=

# Upstash Redis REST credentials, used for AI call rate limiting. Leave
# empty in local dev/tests: the AI package falls back to an in-process
# limiter (single-instance only, not for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Billing. "none" disables checkout; "fake" simulates a provider locally and
# is refused in production. Pick the real provider once the account exists.
BILLING_PROVIDER=none
# Shared secret used to verify webhook signatures (min 16 chars). Server only.
BILLING_WEBHOOK_SECRET=
# Polar (BILLING_PROVIDER=polar). BILLING_WEBHOOK_SECRET above holds the endpoint's
# whsec_... secret. Polar products have a fixed period, so each plan and interval
# has its own product id. Leave the server on sandbox until the live account is
# verified (docs/adr/0009). Server only.
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_PRODUCT_PLUS_MONTH=
POLAR_PRODUCT_PLUS_YEAR=
POLAR_PRODUCT_PRO_MONTH=
POLAR_PRODUCT_PRO_YEAR=
POLAR_PRODUCT_TEAM_MONTH=
POLAR_PRODUCT_TEAM_YEAR=

# Product analytics. Loaded only after the visitor accepts cookies.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
