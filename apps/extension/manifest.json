{
  "manifest_version": 3,
  "name": "Testcim - Soru Yakalama",
  "version": "1.0.0",
  "description": "Herhangi bir web sayfasindan veya PDF'ten sorulari kirpin, saniyeler icinde Testcim sinaviniza ekleyin.",
  "permissions": ["activeTab", "sidePanel", "storage", "scripting"],
  "host_permissions": ["https://*.testcim.com/*", "http://localhost:*/*", "http://127.0.0.1:*/*"],
  "action": {
    "default_title": "Testcim Soru Yakalama"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
